<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>CaaM</AssemblyName>
    <RootNamespace>TVController</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\caam.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <None Include="vendor\sdl3\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="vendor\sdl3\gamecontrollerdb.txt" LogicalName="CaaM.ControllerMappings" />
    <EmbeddedResource Include="ModernShell.html" LogicalName="CaaM.ModernShell" />
    <EmbeddedResource Include="assets\caam-logo-final.png" LogicalName="CaaM.AppLogo" />
    <EmbeddedResource Include="assets\caam.ico" LogicalName="CaaM.AppIcon" />
    <None Include="vendor\sdl3\LICENSE.txt" Link="SDL3-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
